{
  "openapi": "3.0.1",
  "info": {
    "title": "Firewall Execution Agent",
    "version": "1.0.0",
    "description": "Palo Alto PAN-OS firewall operations exposed through Azure Functions. Chat or Hub submit is the only approval. POST /api/firewall/jobs and POST /api/panos/change queue the change immediately. The Jobs page is status only (queued, running, successful, failed)."
  },
  "servers": [
    {
      "url": "https://firewall-execution-agent-gahmfgfghubpa6gk.southindia-01.azurewebsites.net"
    }
  ],
  "components": {
    "securitySchemes": {
      "function_key": {
        "type": "apiKey",
        "in": "query",
        "name": "code",
        "description": "Azure Functions host key."
      }
    }
  },
  "security": [
    {
      "function_key": []
    }
  ],
  "paths": {
    "/api/panos/test_connection": {
      "get": {
        "operationId": "testConnection",
        "summary": "Test firewall connectivity",
        "responses": {
          "200": {
            "description": "Connection successful"
          }
        }
      }
    },
    "/api/panos/info": {
      "get": {
        "operationId": "getFirewallInfo",
        "summary": "Get firewall information",
        "responses": {
          "200": {
            "description": "Firewall information"
          }
        }
      }
    },
    "/api/panos/op": {
      "post": {
        "operationId": "executeOperationalCommand",
        "summary": "Execute PAN-OS operational command",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cmd": {
                    "type": "string"
                  }
                },
                "required": [
                  "cmd"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command execution result"
          }
        }
      }
    },
    "/api/panos/config/get": {
      "post": {
        "operationId": "getConfig",
        "summary": "Get configuration data",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "xpath": {
                    "type": "string"
                  }
                },
                "required": [
                  "xpath"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration retrieved"
          }
        }
      }
    },
    "/api/panos/config/set": {
      "post": {
        "operationId": "setConfig",
        "summary": "Not a live write path. Use PrepareFirewallJob after chat approval.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "xpath": {
                    "type": "string"
                  },
                  "element": {
                    "type": "string"
                  }
                },
                "required": [
                  "xpath",
                  "element"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration created"
          }
        }
      }
    },
    "/api/panos/config/edit": {
      "post": {
        "operationId": "editConfig",
        "summary": "Not a live write path. Use PrepareFirewallJob after chat approval.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "xpath": {
                    "type": "string"
                  },
                  "element": {
                    "type": "string"
                  }
                },
                "required": [
                  "xpath",
                  "element"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration edited"
          }
        }
      }
    },
    "/api/panos/config/delete": {
      "post": {
        "operationId": "deleteConfig",
        "summary": "Not a live write path. Use PrepareFirewallJob after chat approval.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "xpath": {
                    "type": "string"
                  }
                },
                "required": [
                  "xpath"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration deleted"
          }
        }
      }
    },
    "/api/panos/commit": {
      "post": {
        "operationId": "commitConfig",
        "summary": "Not a live write path. Use PrepareFirewallJob after chat approval.",
        "responses": {
          "200": {
            "description": "Commit successful"
          }
        }
      }
    },
    "/api/panos/workbook/run": {
      "post": {
        "operationId": "runWorkbook",
        "summary": "Queue a bulk workbook job after chat or Hub submit",
        "description": "Parses a filled-in .xlsx workbook and queues a firewall job. Chat or Hub Execute is the only approval. Do not send users to Jobs to approve. Do not invent xpaths.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workbook_base64": {
                    "type": "string",
                    "description": "Base64-encoded .xlsx workbook"
                  },
                  "workbook_name": {
                    "type": "string",
                    "description": "Original workbook file name"
                  },
                  "row_limit": {
                    "type": "integer",
                    "description": "Optional per-sheet row cap"
                  }
                },
                "required": [
                  "workbook_base64"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workbook job queued. Watch Jobs for queued, running, successful, or failed."
          }
        }
      }
    },
    "/api/panos/change": {
      "post": {
        "operationId": "prepareFirewallChange",
        "summary": "Queue one structured firewall change after chat approval",
        "description": "Call only after the user approves in chat. Queues the change immediately. Do not send the user to Jobs to approve.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": { "type": "string" },
                  "action": { "type": "string" },
                  "name": { "type": "string" },
                  "fields": { "type": "object" },
                  "source_type": { "type": "string" },
                  "user_id": { "type": "string" }
                },
                "required": ["category", "action", "name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job queued"
          }
        }
      }
    },
    "/api/firewall/jobs": {
      "get": {
        "operationId": "listFirewallJobs",
        "summary": "List firewall jobs",
        "responses": {
          "200": {
            "description": "Job list"
          }
        }
      },
      "post": {
        "operationId": "PrepareFirewallJob",
        "summary": "Queue a firewall job after chat or Hub approval",
        "description": "Chat or Hub Execute is the only approval. This call queues the job. Jobs is status only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operation": { "type": "string" },
                  "source_type": { "type": "string" },
                  "source_name": { "type": "string" },
                  "device_group": { "type": "string" },
                  "firewall_host": { "type": "string" },
                  "changes": { "type": "array", "items": { "type": "object" } },
                  "user_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job queued"
          }
        }
      }
    },
    "/api/firewall/jobs/{task_id}": {
      "get": {
        "operationId": "getFirewallJob",
        "summary": "Get one firewall job",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status"
          }
        }
      }
    }
  }
}