{
  "openapi": "3.0.1",
  "info": {
    "title": "Firewall Execution Agent - AI Workspace API",
    "version": "3.3.0",
    "description": "Agent-facing API for read-only PAN-OS queries and job-based firewall changes. Every create, update or delete must resolve one unique managed firewall first. Use firewall_id/target_asset_id or firewall_name. firewall_host may be that unique name or id. Shared host IP is rejected. Never reuse a previous job target. Never send ALL. Missing target returns MISSING_FIREWALL plus inventory and the preserved pending write. Unknown name or id returns INVALID_FIREWALL. After a unique live firewall is selected, call PrepareFirewallJob. Prepare always returns status pending_approval and approval_status pending. Prepare does not approve, queue, or publish to Service Bus. Present the prepared job and wait for an explicit user decision. Only ApproveFirewallJob queues the job. RejectFirewallJob cancels with no PAN-OS change. The worker refuses any job that is not approved and queued."
  },
  "servers": [
    {
      "url": "https://firewall-execution-agent-gahmfgfghubpa6gk.southindia-01.azurewebsites.net"
    }
  ],
  "security": [
    {
      "function_key": []
    }
  ],
  "components": {
    "securitySchemes": {
      "function_key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-functions-key",
        "description": "Azure Functions function or host key."
      }
    },
    "schemas": {
      "ChangeFields": {
        "type": "object",
        "additionalProperties": true,
        "description": "Category-specific firewall configuration fields. Examples include Address Value and Address Type for address objects, Protocol and Port for services, and From, To, Source, Destination, Applications, Services and Action for security rules."
      },
      "FirewallChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "action",
          "name"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "source_sheet": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "example": "Addresses"
          },
          "source_row": {
            "type": "integer",
            "minimum": 1,
            "nullable": true,
            "example": 2
          },
          "category": {
            "type": "string",
            "enum": [
              "address",
              "address_group",
              "service",
              "service_group",
              "zone",
              "virtual_router",
              "static_route",
              "interface",
              "interface_mgmt_profile",
              "security_rule",
              "nat_rule"
            ],
            "example": "address"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ],
            "example": "create"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "webserver12"
          },
          "fields": {
            "$ref": "#/components/schemas/ChangeFields"
          }
        }
      },
      "ManagedFirewall": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "2",
            "description": "Unique managed_firewalls.id."
          },
          "firewall_id": {
            "type": "string",
            "example": "2"
          },
          "target_asset_id": {
            "type": "string",
            "example": "2"
          },
          "firewall_name": {
            "type": "string",
            "example": "vmpafw01"
          },
          "device_name": {
            "type": "string",
            "example": "vmpafw01"
          },
          "name": {
            "type": "string",
            "example": "vmpafw01"
          },
          "host_ip": {
            "type": "string",
            "example": "20.44.53.215"
          },
          "firewall_host": {
            "type": "string",
            "example": "20.44.53.215",
            "description": "Resolved host IP after unique identity match. Do not send this shared IP as the write target."
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "down"
            ],
            "example": "live"
          },
          "vendor": {
            "type": "string",
            "example": "Palo Alto"
          }
        }
      },
      "PendingWrite": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "example": "address"
          },
          "action": {
            "type": "string",
            "example": "create"
          },
          "name": {
            "type": "string",
            "example": "webserver12"
          },
          "fields": {
            "$ref": "#/components/schemas/ChangeFields"
          },
          "operation": {
            "type": "string",
            "example": "apply_change"
          },
          "conversation_id": {
            "type": "string"
          },
          "bulk": {
            "type": "boolean"
          }
        },
        "description": "Preserved original write. Continue this change after the user selects a unique firewall. Do not ask what to do with the selected firewall."
      },
      "PrepareFirewallJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "conversation_id",
          "changes"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "apply_change",
              "apply_bulk"
            ],
            "example": "apply_change",
            "description": "Use apply_change for exactly one natural-language change. Use apply_bulk for Excel-derived changes."
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "conversation-001",
            "description": "AI Workspace conversation identifier."
          },
          "user_id": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "agent_id": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "source_type": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "example": "ai_workspace"
          },
          "source_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "example": "Create webserver12"
          },
          "source_file_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "maxLength": 64,
            "description": "conversation_attachments.id for apply_bulk."
          },
          "firewall_id": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "example": "2",
            "description": "Unique managed_firewalls.id. Live inventory ids include 2, 4, 5."
          },
          "firewall_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "example": "vmpafw01",
            "description": "Unique managed firewall name. Live inventory names include vmpafw01, vmpafw03, vmpafw04."
          },
          "device_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "description": "Alias of firewall_name."
          },
          "target_asset_id": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "example": "2",
            "description": "Same unique identity as firewall_id. Preferred Foundry field when firewall_id is not sent."
          },
          "firewall_host": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "example": "vmpafw01",
            "description": "Unique firewall_name or firewall_id for this write. Example: vmpafw01 or 2. Shared clone IP 20.44.53.215 is rejected."
          },
          "device_group": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "example": "vsys1"
          },
          "auto_create": {
            "type": "boolean",
            "default": true
          },
          "stop_on_error": {
            "type": "boolean",
            "default": true
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/FirewallChange"
            },
            "description": "Exactly one item for apply_change. One or more Excel-derived items for apply_bulk."
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "description": "security_jobs.status. Prepare writes pending_approval. awaiting_approval is a legacy prepare alias. Only ApproveFirewallJob may set queued.",
        "enum": [
          "pending_approval",
          "awaiting_approval",
          "queued",
          "running",
          "committing",
          "completed",
          "failed",
          "cancelled",
          "timeout",
          "rejected"
        ],
        "example": "pending_approval"
      },
      "ApprovalStatus": {
        "type": "string",
        "description": "security_jobs.approval_status. Prepare writes pending. Only ApproveFirewallJob may set approved.",
        "enum": [
          "pending",
          "approved",
          "rejected"
        ],
        "example": "pending"
      },
      "JobSummary": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "valid": {
            "type": "integer",
            "minimum": 0
          },
          "invalid": {
            "type": "integer",
            "minimum": 0
          },
          "pending": {
            "type": "integer",
            "minimum": 0
          },
          "successful": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "nullable": true
          },
          "source_sheet": {
            "type": "string",
            "nullable": true
          },
          "source_row": {
            "type": "integer",
            "nullable": true
          },
          "field": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PreparedOperation": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer"
          },
          "source_sheet": {
            "type": "string",
            "nullable": true
          },
          "source_row": {
            "type": "integer",
            "nullable": true
          },
          "category": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "requested_name": {
            "type": "string"
          },
          "normalized_name": {
            "type": "string"
          },
          "normalized_fields": {
            "type": "object",
            "additionalProperties": true
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "invalid"
            ]
          }
        }
      },
      "PrepareFirewallJobResponse": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 64
          },
          "operation": {
            "type": "string",
            "enum": [
              "apply_change",
              "apply_bulk"
            ]
          },
          "source_type": {
            "type": "string"
          },
          "source_name": {
            "type": "string",
            "nullable": true
          },
          "conversation_id": {
            "type": "string"
          },
          "firewall_id": {
            "type": "string",
            "nullable": true
          },
          "firewall_name": {
            "type": "string",
            "nullable": true
          },
          "target_asset_id": {
            "type": "string",
            "nullable": true
          },
          "firewall_host": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobStatus"
              }
            ],
            "description": "Always pending_approval after PrepareFirewallJob. Never queued, approved, or completed from prepare."
          },
          "approval_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApprovalStatus"
              }
            ],
            "description": "Always pending after PrepareFirewallJob. Prepare does not set approved."
          },
          "summary": {
            "$ref": "#/components/schemas/JobSummary"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PreparedOperation"
            }
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          },
          "payload_hash": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "plan_hash": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "description": "Present the prepared job and wait for an explicit user approve or reject. Do not call ApproveFirewallJob automatically.",
            "example": "Job prepared. status=pending_approval approval_status=pending. Waiting for explicit user approval. Not queued."
          },
          "queued": {
            "type": "boolean",
            "description": "Always false after PrepareFirewallJob. True only after ApproveFirewallJob publishes to Service Bus.",
            "example": false
          }
        }
      },
      "FirewallSelectionResponse": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message",
          "selection_required"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "MISSING_FIREWALL",
              "INVALID_FIREWALL",
              "AMBIGUOUS_FIREWALL",
              "SELECT_FIREWALL"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "MISSING_FIREWALL",
              "INVALID_FIREWALL",
              "AMBIGUOUS_FIREWALL",
              "SELECT_FIREWALL"
            ]
          },
          "message": {
            "type": "string"
          },
          "selection_required": {
            "type": "boolean",
            "example": true
          },
          "action_required": {
            "type": "string",
            "example": "select_firewall"
          },
          "firewalls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManagedFirewall"
            }
          },
          "managed_firewalls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManagedFirewall"
            }
          },
          "pending_write": {
            "$ref": "#/components/schemas/PendingWrite"
          }
        }
      },
      "ApproveFirewallJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "approve": {
            "type": "boolean",
            "default": true,
            "description": "true queues a pending_approval/pending job. false rejects it with no PAN-OS change."
          },
          "user_id": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "payload_hash": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "plan_hash": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "comment": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          }
        }
      },
      "RejectFirewallJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "Optional reject reason stored on the job."
          },
          "comment": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "description": "Alias of reason."
          }
        }
      },
      "JobDecisionResponse": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "approval_status": {
            "$ref": "#/components/schemas/ApprovalStatus"
          },
          "queued": {
            "type": "boolean",
            "description": "true only after a successful ApproveFirewallJob publish to Service Bus."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "JobOperationResult": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer"
          },
          "source_sheet": {
            "type": "string",
            "nullable": true
          },
          "source_row": {
            "type": "integer",
            "nullable": true
          },
          "category": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "object_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "success",
              "failed",
              "skipped"
            ]
          },
          "result": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "error_code": {
            "type": "string",
            "nullable": true
          },
          "error_message": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "FirewallJobResponse": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "apply_change",
              "apply_bulk"
            ]
          },
          "source_type": {
            "type": "string"
          },
          "source_name": {
            "type": "string",
            "nullable": true
          },
          "conversation_id": {
            "type": "string",
            "nullable": true
          },
          "firewall_id": {
            "type": "string",
            "nullable": true
          },
          "firewall_name": {
            "type": "string",
            "nullable": true
          },
          "target_asset_id": {
            "type": "string",
            "nullable": true
          },
          "firewall_host": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "approval_status": {
            "$ref": "#/components/schemas/ApprovalStatus"
          },
          "summary": {
            "$ref": "#/components/schemas/JobSummary"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobOperationResult"
            }
          },
          "result": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "error_message": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "GetFirewallConfigRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "xpath"
        ],
        "properties": {
          "xpath": {
            "type": "string",
            "minLength": 1,
            "description": "PAN-OS XPath to retrieve. Read-only."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          }
        }
      }
    }
  },
  "paths": {
    "/api/firewall/inventory": {
      "get": {
        "operationId": "ListManagedFirewalls",
        "summary": "List managed firewalls for write-target selection",
        "responses": {
          "200": {
            "description": "Managed firewall inventory.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirewallSelectionResponse"
                }
              }
            }
          }
        },
        "description": "Call this when a write has no unique firewall_id or firewall_name. Never reuse a previous job target. Preserve the pending write and present these firewalls. After the user selects one live firewall by firewall_id or firewall_name, continue the original write. Do not ask what to do with the selected firewall."
      }
    },
    "/api/firewall/preflight": {
      "get": {
        "operationId": "PreflightFirewallTarget",
        "summary": "Validate a unique managed firewall before PrepareFirewallJob",
        "parameters": [
          {
            "name": "firewall_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target_asset_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "firewall_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "firewall_host",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Unique firewall_name or firewall_id. Shared IP is rejected."
          }
        ],
        "responses": {
          "200": {
            "description": "Unique firewall resolved and reachable."
          },
          "400": {
            "description": "Missing, invalid, or ambiguous firewall selection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirewallSelectionResponse"
                }
              }
            }
          }
        },
        "description": "Resolves firewall_id, target_asset_id, firewall_name, or unique firewall_host (name or id) against managed_firewalls. Shared host IP is rejected. Returns live reachability for the unique match."
      }
    },
    "/api/firewall/jobs": {
      "post": {
        "operationId": "PrepareFirewallJob",
        "summary": "Prepare an AI Workspace firewall change job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareFirewallJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Firewall job prepared with status pending_approval and approval_status pending. Not queued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrepareFirewallJobResponse"
                }
              }
            }
          },
          "201": {
            "description": "Firewall job prepared with status pending_approval and approval_status pending. Waiting for explicit user approval. Not queued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrepareFirewallJobResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid firewall selection, or change validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirewallSelectionResponse"
                }
              }
            }
          },
          "409": {
            "description": "Selected firewall is down."
          },
          "500": {
            "description": "Job preparation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "Use this for every AI Workspace firewall create, update or delete. Every write requires one unique managed firewall: firewall_id/target_asset_id or firewall_name. firewall_host may be that unique name (vmpafw01) or id (2). Host IP alone is rejected. Never reuse a previous job target. Missing target returns MISSING_FIREWALL plus managed_firewalls and the preserved pending write. Unknown name or id returns INVALID_FIREWALL. For apply_change, changes must contain exactly one item. For apply_bulk, source_file_id identifies the Excel attachment. Prepare only stores the job as status pending_approval and approval_status pending. It does not approve, queue, or publish to Service Bus. Do not call ApproveFirewallJob automatically after this operation."
      }
    },
